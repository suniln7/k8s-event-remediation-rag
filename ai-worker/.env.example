# Kafka -- the "plain" listener (9092) only advertises the broker's in-cluster DNS name, so a
# real Kafka client gets redirected there post-bootstrap and fails to resolve it from the host.
# Reached instead via the "external" nodeport listener (kafka-cluster.yaml), which advertises
# "localhost:9094" -- satisfied by one tunnel that covers both bootstrap and the redirect:
#   kubectl port-forward pod/my-cluster-mixed-pool-0 9094:9094 -n kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=k8s-cluster-alerts
KAFKA_GROUP_ID=ai-remediation-worker

# Qdrant -- reachable directly at localhost:6333 via cluster.yaml's kind extraPortMappings
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=k8s-playbooks

# Ollama -- runs natively on the Mac (Phase 1), not in the cluster
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=Qwen2.5:32b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# Kubernetes -- context for the kubernetes python client (get_pod_logs/describe_pod/etc.)
K8S_CONTEXT=kind-qdrant-local-cluster

# Where structured remediation reports get written (Phase 4 will replace/augment this with a
# git commit + Argo CD sync instead of a local file)
OUTPUT_DIR=./output
PLAYBOOKS_DIR=./playbooks
